<Window x:Class="Overlay.FarmOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Overlay"
        mc:Ignorable="d"
        Title="Farm Overlay"
        Width="320" Height="200"
        Topmost="True"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#CC1E1E1E">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" Grid.Row="0"
                   Text="Nekros Prime" FontSize="18" FontWeight="Regular"
                   Foreground="White" HorizontalAlignment="Center"/>

        <StackPanel x:Name="ItemsPanel" Grid.Row="1" Margin="0,8,0,0"/>
    </Grid>
</Window>