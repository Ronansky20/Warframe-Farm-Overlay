<Window x:Class="Overlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Warframe Farm Helper" Height="450" Width="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBox x:Name="TargetBox" Width="250" VerticalContentAlignment="Center"
                     TextChanged="TargetBox_TextChanged"
                     PreviewKeyDown="TargetBox_PreviewKeyDown"/>
            <Button x:Name="FarmButton" Content="Farm" Width="80" Margin="8,0,0,0" Click="FarmButton_Click"/>

            <Popup x:Name="SuggestPopup" PlacementTarget="{Binding ElementName=TargetBox}"
                   Placement="Bottom" Width="250" StaysOpen="False">
                <ListBox x:Name="SuggestList" MaxHeight="200" MouseUp="SuggestList_MouseUp"/>
            </Popup>
        </StackPanel>

        <ListBox x:Name="ResultsList" Grid.Row="1" Margin="0,10,0,0"/>

        <TextBlock x:Name="StatusText" Grid.Row="2" Margin="0,6,0,0" Foreground="Gray"/>
    </Grid>
</Window>